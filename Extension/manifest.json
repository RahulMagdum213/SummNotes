{
    "manifest_version": 3,
    "name": "AI Text Summarizer",
    "version": "1.0",
    "description": "Summarize selected text using Gemini AI.",

    "permissions": [
        "activeTab",
        "scripting"
    ],

    "host_permissions": [
        "http://localhost:8080/*"
    ],

    "action": {
        "default_title": "AI Text Summarizer",
        "default_popup": "popup.html"
    }
}